# Supabase Client Configuration
VITE_SUPABASE_URL=https://sua-url-supabase.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Supabase Admin / Service Role (Usado apenas em scripts de automação / setup de usuários)
# CUIDADO: NUNCA exponha a chave de serviço no frontend ou em repositórios públicos
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
